{
  "schema": 1,
  "books": {
    "opening": {
      "title": "Before the ninth night",
      "before": "p_bay",
      "music": {
        "file": "res://assets/audio/music/prologue-theme.mp3",
        "bar": 0
      },
      "end_bar": 20,
      "panels": [
        {
          "bar": 0,
          "image": "res://assets/illustrated/campaign/rooms/c1_pier.webp",
          "from": [
            0.42,
            0.56,
            1.0
          ],
          "to": [
            0.56,
            0.48,
            1.12
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "Bellwether. A fishing town on the Pacific coast.",
              "narration": "res://assets/audio/voices/narration/opening-01.wav",
              "seconds": 3.587
            },
            {
              "bar": 1.497,
              "text": "Six thousand people, one radio station, and a lot of fog.",
              "narration": "res://assets/audio/voices/narration/opening-02.wav",
              "seconds": 4.377
            }
          ]
        },
        {
          "bar": 3.5,
          "image": "res://assets/illustrated/campaign/rooms/c10_station.webp",
          "from": [
            0.5,
            0.55,
            1.14
          ],
          "to": [
            0.6,
            0.45,
            1.02
          ],
          "lines": [
            {
              "bar": 3.75,
              "text": "I’m Steve Mercer. For years I ran the night shift at KBWR, the town radio station.",
              "narration": "res://assets/audio/voices/narration/opening-03.wav",
              "seconds": 5.907
            },
            {
              "bar": 5.731,
              "text": "Nobody hears the night engineer. The night engineer hears everything.",
              "narration": "res://assets/audio/voices/narration/opening-04.wav",
              "seconds": 4.723
            }
          ]
        },
        {
          "bar": 7.5,
          "image": "res://assets/illustrated/campaign/stills/book-frank-radio.webp",
          "from": [
            0.35,
            0.6,
            1.1
          ],
          "to": [
            0.45,
            0.55,
            1.0
          ],
          "lines": [
            {
              "bar": 7.75,
              "text": "My dad, Frank, taught me how to listen.",
              "narration": "res://assets/audio/voices/narration/opening-05.wav",
              "seconds": 3.06
            },
            {
              "bar": 8.83,
              "text": "Ham radio, every night. Strangers from all over the world, all of them his friends.",
              "narration": "res://assets/audio/voices/narration/opening-06.wav",
              "seconds": 5.908
            }
          ]
        },
        {
          "bar": 11.0,
          "image": "res://assets/illustrated/rooms/meeting.png",
          "from": [
            0.5,
            0.45,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.12
          ],
          "lines": [
            {
              "bar": 11.25,
              "text": "My mom, Helen, was an interpreter. Government work, rooms with no windows. She never talked about it.",
              "narration": "res://assets/audio/voices/narration/opening-07.wav",
              "seconds": 7.37
            },
            {
              "bar": 13.695,
              "text": "She could hear what people meant, even when they said something else.",
              "narration": "res://assets/audio/voices/narration/opening-08.wav",
              "seconds": 3.772
            }
          ]
        },
        {
          "bar": 15.5,
          "image": "res://assets/illustrated/rooms/bay.png",
          "from": [
            0.5,
            0.42,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.16
          ],
          "lines": [
            {
              "bar": 15.75,
              "text": "Eighteen months ago, they rowed out into the bay after dark. They said the water was making a sound.",
              "narration": "res://assets/audio/voices/narration/opening-09.wav",
              "seconds": 5.858
            },
            {
              "bar": 17.716,
              "text": "They asked me to come along.",
              "narration": "res://assets/audio/voices/narration/opening-10.wav",
              "seconds": 1.55
            },
            {
              "bar": 18.318,
              "text": "I said no. I had a shift.",
              "narration": "res://assets/audio/voices/narration/opening-11.wav",
              "seconds": 2.584
            }
          ]
        }
      ]
    },
    "aftermath": {
      "title": "Eighteen months",
      "before": "c1_flat",
      "music": {
        "file": "res://assets/audio/music/prologue-theme.mp3",
        "bar": 37,
        "continue": true
      },
      "end_bar": 54,
      "panels": [
        {
          "bar": 37,
          "image": "res://assets/illustrated/campaign/rooms/c8_beach.webp",
          "from": [
            0.5,
            0.5,
            1.12
          ],
          "to": [
            0.62,
            0.62,
            1.22
          ],
          "lines": [
            {
              "bar": 37.25,
              "text": "In the morning, their boat drifted back to shore. Empty.",
              "narration": "res://assets/audio/voices/narration/aftermath-01.wav",
              "seconds": 3.738
            },
            {
              "bar": 38.545,
              "text": "Dad’s radio was still on.",
              "narration": "res://assets/audio/voices/narration/aftermath-02.wav",
              "seconds": 2.07
            }
          ]
        },
        {
          "bar": 39.5,
          "image": "res://assets/illustrated/campaign/rooms/c1_escape.webp",
          "from": [
            0.55,
            0.5,
            1.0
          ],
          "to": [
            0.45,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 39.75,
              "text": "Nobody found them. That was eighteen months ago.",
              "narration": "res://assets/audio/voices/narration/aftermath-03.wav",
              "seconds": 3.309
            },
            {
              "bar": 40.909,
              "text": "Most nights I still play Mom’s last voicemail. I don’t know what I’m listening for.",
              "narration": "res://assets/audio/voices/narration/aftermath-04.wav",
              "seconds": 5.43
            }
          ]
        },
        {
          "bar": 43.0,
          "image": "res://assets/illustrated/campaign/wide/c5_station.webp",
          "from": [
            0.5,
            0.5,
            1.12
          ],
          "to": [
            0.5,
            0.45,
            1.0
          ],
          "lines": [
            {
              "bar": 43.25,
              "text": "Three weeks ago, a company called Halcyon Media bought KBWR.",
              "narration": "res://assets/audio/voices/narration/aftermath-05.wav",
              "seconds": 5.0
            },
            {
              "bar": 44.944,
              "text": "They replaced me with a machine called DJ AutoRick. He reads yesterday’s weather.",
              "narration": "res://assets/audio/voices/narration/aftermath-06.wav",
              "seconds": 5.51
            }
          ]
        },
        {
          "bar": 47.0,
          "image": "res://assets/illustrated/campaign/inserts/c1_pier.webp",
          "from": [
            0.5,
            0.5,
            1.0
          ],
          "to": [
            0.6,
            0.45,
            1.14
          ],
          "lines": [
            {
              "bar": 47.25,
              "text": "And then there’s Nora. Nora Reyes runs the aquarium and argues with everybody, me included.",
              "narration": "res://assets/audio/voices/narration/aftermath-07.wav",
              "seconds": 6.96
            },
            {
              "bar": 49.565,
              "text": "Now that I’m home in the mornings, I get to hear her say good morning.",
              "narration": "res://assets/audio/voices/narration/aftermath-08.wav",
              "seconds": 3.371
            }
          ]
        },
        {
          "bar": 51.0,
          "image": "res://assets/illustrated/title.webp",
          "from": [
            0.74,
            0.4,
            1.62
          ],
          "to": [
            0.5,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 51.25,
              "text": "This is the story of how I started counting nights.",
              "narration": "res://assets/audio/voices/narration/aftermath-09.wav",
              "seconds": 3.156
            }
          ]
        }
      ]
    },
    "after": {
      "title": "After the ninth night",
      "before": "one_year",
      "music": {
        "file": "res://assets/audio/music/prologue-theme.mp3",
        "bar": 31,
        "continue": true
      },
      "end_bar": 54,
      "panels": [
        {
          "bar": 31,
          "image": "res://assets/illustrated/campaign/rooms/epilogue.webp",
          "from": [
            0.45,
            0.5,
            1.0
          ],
          "to": [
            0.55,
            0.5,
            1.12
          ],
          "lines": [
            {
              "bar": 31.25,
              "text": "Before the ship left, the Choir gave the copies one last gift. They don’t need the ninth night anymore.",
              "narration": "res://assets/audio/voices/narration/after-01.wav",
              "seconds": 6.745
            },
            {
              "bar": 33.497,
              "text": "More than two hundred of them stayed. Bellwether has a lot of new neighbors with familiar faces.",
              "narration": "res://assets/audio/voices/narration/after-02.wav",
              "seconds": 6.26
            }
          ]
        },
        {
          "bar": 36.0,
          "image": "res://assets/illustrated/campaign/stills/epilogue-new-face.webp",
          "from": [
            0.5,
            0.5,
            1.0
          ],
          "to": [
            0.46,
            0.42,
            1.12
          ],
          "lines": [
            {
              "bar": 36.25,
              "text": "Sunday dinner is still at six. Iris comes too.",
              "narration": "res://assets/audio/voices/narration/after-03.wav",
              "seconds": 3.519
            },
            {
              "bar": 37.475,
              "text": "Nora hasn’t forgiven her for the kidnapping. She tells her so, and passes her the bread.",
              "narration": "res://assets/audio/voices/narration/after-04.wav",
              "seconds": 5.307
            }
          ]
        },
        {
          "bar": 39.5,
          "image": "res://assets/illustrated/campaign/stills/book-frank-radio.webp",
          "from": [
            0.45,
            0.55,
            1.0
          ],
          "to": [
            0.35,
            0.6,
            1.12
          ],
          "lines": [
            {
              "bar": 39.75,
              "text": "Mom and Dad came home. Dad is back on the radio every Thursday.",
              "narration": "res://assets/audio/voices/narration/after-05.wav",
              "seconds": 4.243
            },
            {
              "bar": 41.204,
              "text": "There’s a new note on the kitchen table every morning. Most of them are about paint.",
              "narration": "res://assets/audio/voices/narration/after-06.wav",
              "seconds": 5.35
            }
          ]
        },
        {
          "bar": 43.5,
          "image": "res://assets/illustrated/title.webp",
          "from": [
            0.72,
            0.46,
            1.6
          ],
          "to": [
            0.75,
            0.38,
            1.72
          ],
          "lines": [
            {
              "bar": 43.75,
              "text": "I don’t play the old voicemail anymore.",
              "narration": "res://assets/audio/voices/narration/after-07.wav",
              "seconds": 2.37
            },
            {
              "bar": 44.611,
              "text": "The ring moved from my sock drawer to my cardigan pocket. Nora and I are starting with coffee, and an actual conversation.",
              "narration": "res://assets/audio/voices/narration/after-08.wav",
              "seconds": 7.945
            }
          ]
        },
        {
          "bar": 47.5,
          "image": "res://assets/illustrated/campaign/rooms/one_year.webp",
          "from": [
            0.4,
            0.5,
            1.12
          ],
          "to": [
            0.55,
            0.45,
            1.0
          ],
          "lines": [
            {
              "bar": 47.75,
              "text": "KBWR has live hosts again. Two of them.",
              "narration": "res://assets/audio/voices/narration/after-09.wav",
              "seconds": 3.65
            },
            {
              "bar": 49.017,
              "text": "Stephen and I still argue about which one of us is the upgrade.",
              "narration": "res://assets/audio/voices/narration/after-10.wav",
              "seconds": 3.772
            }
          ]
        },
        {
          "bar": 50.5,
          "image": "res://assets/illustrated/campaign/films/one_year.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.62,
            0.42,
            1.15
          ],
          "lines": [
            {
              "bar": 50.75,
              "text": "One year after the ninth night, a package arrived at the station.",
              "narration": "res://assets/audio/voices/narration/after-11.wav",
              "seconds": 3.867
            },
            {
              "bar": 52.085,
              "text": "From very, very far away.",
              "narration": "res://assets/audio/voices/narration/after-12.wav",
              "seconds": 2.963
            }
          ]
        }
      ]
    },
    "ch2": {
      "title": "Into the water",
      "before": "c2_aquarium",
      "music": {
        "file": "res://assets/audio/music/chapter-02-theme.mp3",
        "bar": 0
      },
      "end_bar": 12,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch2-walkers.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "Nobody swam. Nobody called for help. They walked into the bay in their good shoes, and the water closed over them.",
              "narration": "",
              "seconds": 7.76
            },
            {
              "bar": 2.749,
              "text": "Lyle Boone. Gus from the bakery. People I’d waved at my whole life.",
              "narration": "",
              "seconds": 5.68
            }
          ]
        },
        {
          "bar": 5,
          "image": "res://assets/illustrated/campaign/stills/book-ch2-footprints.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 5.25,
              "text": "Then the light went out of the water. Mrs. Penhallow’s step was empty. Only the footprints were left.",
              "narration": "",
              "seconds": 6.72
            }
          ]
        },
        {
          "bar": 8,
          "image": "res://assets/illustrated/campaign/stills/book-ch2-call.webp",
          "from": [
            0.58,
            0.5,
            1.0
          ],
          "to": [
            0.44,
            0.52,
            1.1
          ],
          "lines": [
            {
              "bar": 8.25,
              "text": "I dug out my flip phone. My hands shook so badly that I misdialed twice.",
              "narration": "",
              "seconds": 5.44
            }
          ]
        }
      ]
    },
    "ch3": {
      "title": "Protective custody",
      "before": "c3_house",
      "music": {
        "file": "res://assets/audio/music/chapter-03-theme.mp3",
        "bar": 1
      },
      "end_bar": 11,
      "panels": [
        {
          "bar": 1.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch3-amber.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 1.25,
              "text": "I had seen her. Nora, asleep in amber light, breathing a little behind the ship’s own rhythm.",
              "narration": "",
              "seconds": 6.96
            }
          ]
        },
        {
          "bar": 4,
          "image": "res://assets/illustrated/campaign/stills/book-ch3-shallows.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 4.25,
              "text": "Admiral left me in the shallows at first light, then swam back out into the dark water without me.",
              "narration": "",
              "seconds": 6.4
            }
          ]
        },
        {
          "bar": 7,
          "image": "res://assets/illustrated/campaign/stills/book-ch3-alone.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 7.25,
              "text": "Getting off the ship was the easy part. The hard part was finding one person who would believe me.",
              "narration": "",
              "seconds": 6.32
            }
          ]
        }
      ]
    },
    "interlude1": {
      "title": "Meanwhile, under the bay",
      "before": "i1_archive",
      "music": {
        "file": "res://assets/audio/music/interlude-archivist-theme.mp3",
        "bar": 0
      },
      "end_bar": 10,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-i1-seabed.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "I didn’t learn the rest of that night until much later.",
              "narration": "",
              "seconds": 3.2
            },
            {
              "bar": 1.422,
              "text": "While June and I watched from the boathouse, two hundred and seventy-four people walked along the floor of the bay, toward a light.",
              "narration": "",
              "seconds": 7.92
            }
          ]
        },
        {
          "bar": 5,
          "image": "res://assets/illustrated/campaign/stills/book-i1-archivist.webp",
          "from": [
            0.58,
            0.5,
            1.0
          ],
          "to": [
            0.44,
            0.52,
            1.1
          ],
          "lines": [
            {
              "bar": 5.25,
              "text": "Under the bay, in a hall of glass records, someone was waiting for them.",
              "narration": "",
              "seconds": 5.12
            },
            {
              "bar": 7.014,
              "text": "She had been keeping records for nine hundred years.",
              "narration": "",
              "seconds": 3.6
            }
          ]
        }
      ]
    },
    "ch4": {
      "title": "Help is coming",
      "before": "c4_safe",
      "music": {
        "file": "res://assets/audio/music/chapter-04-theme.mp3",
        "bar": 2
      },
      "end_bar": 12,
      "panels": [
        {
          "bar": 2.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch4-calls.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 2.25,
              "text": "For two days June called in favors from people she trusted, and I copied every tape I owned. Twice.",
              "narration": "",
              "seconds": 7.12
            }
          ]
        },
        {
          "bar": 5,
          "image": "res://assets/illustrated/campaign/stills/book-ch4-photo.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 5.25,
              "text": "She trusted Adrian Rook with her life. Twenty years ago, he had helped her bring a kidnapped child home.",
              "narration": "",
              "seconds": 7.12
            }
          ]
        },
        {
          "bar": 8,
          "image": "res://assets/illustrated/campaign/stills/book-ch4-hills.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 8.25,
              "text": "Help is coming, she said. I wanted to believe that more than anything.",
              "narration": "",
              "seconds": 5.28
            }
          ]
        }
      ]
    },
    "ch5": {
      "title": "The long walk",
      "before": "c5_shack",
      "music": {
        "file": "res://assets/audio/music/chapter-05-theme.mp3",
        "bar": 0
      },
      "end_bar": 11,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch5-creek.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "The creek was colder than the bay. I followed it down through the dark, one stone at a time.",
              "narration": "",
              "seconds": 6.32
            }
          ]
        },
        {
          "bar": 3,
          "image": "res://assets/illustrated/campaign/stills/book-ch5-searchlight.webp",
          "from": [
            0.58,
            0.5,
            1.0
          ],
          "to": [
            0.44,
            0.52,
            1.1
          ],
          "lines": [
            {
              "bar": 3.25,
              "text": "Twice a searchlight crossed the trees above me. Twice I held my breath and counted, the way Dad taught me to count after lightning.",
              "narration": "",
              "seconds": 8.8
            }
          ]
        },
        {
          "bar": 7,
          "image": "res://assets/illustrated/campaign/stills/book-ch5-firstlight.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 7.25,
              "text": "At first light I could see the bay again. And on the bluff above it, a roof I knew.",
              "narration": "",
              "seconds": 5.52
            }
          ]
        }
      ]
    },
    "ch6": {
      "title": "Two of us",
      "before": "c6_iris",
      "music": {
        "file": "res://assets/audio/music/chapter-06-theme.mp3",
        "bar": 1
      },
      "end_bar": 11,
      "panels": [
        {
          "bar": 1.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch6-path.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 1.25,
              "text": "I walked home that night with a man who had my face, my voice, and a year and a half of my life missing.",
              "narration": "",
              "seconds": 6.96
            }
          ]
        },
        {
          "bar": 4,
          "image": "res://assets/illustrated/campaign/stills/book-ch6-notebook.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 4.25,
              "text": "Mom’s notebook sat on Dad’s workbench between us. Neither of us could read a word of it.",
              "narration": "",
              "seconds": 5.76
            }
          ]
        },
        {
          "bar": 7,
          "image": "res://assets/illustrated/campaign/stills/book-ch6-mirror.webp",
          "from": [
            0.58,
            0.5,
            1.0
          ],
          "to": [
            0.44,
            0.52,
            1.1
          ],
          "lines": [
            {
              "bar": 7.25,
              "text": "But he knew how I take my coffee, and which stair creaks at Mom’s house. It was like meeting a brother I already was.",
              "narration": "",
              "seconds": 7.84
            }
          ]
        }
      ]
    },
    "interlude2": {
      "title": "Meanwhile, Nora",
      "before": "i2_nora",
      "music": {
        "file": "res://assets/audio/music/interlude-nora-theme.mp3",
        "bar": 0
      },
      "end_bar": 8,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-i2-van.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "That night five fugitives and a beagle slept in Gus’s bakery van. It smelled of cinnamon and wet dog.",
              "narration": "",
              "seconds": 7.36
            }
          ]
        },
        {
          "bar": 3,
          "image": "res://assets/illustrated/campaign/stills/book-i2-ship.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 3.25,
              "text": "Under the bay, the slow wake Iris had started was finishing.",
              "narration": "",
              "seconds": 4.4
            },
            {
              "bar": 4.792,
              "text": "Nora told me this part herself, much later. She still tells it better than I do.",
              "narration": "",
              "seconds": 5.44
            }
          ]
        }
      ]
    },
    "ch7": {
      "title": "Wednesday",
      "before": "c7_gate",
      "music": {
        "file": "res://assets/audio/music/chapter-07-theme.mp3",
        "bar": 0
      },
      "end_bar": 10,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch7-tv.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "On Wednesday morning, every television in Bellwether showed the same field of old antennas.",
              "narration": "",
              "seconds": 5.92
            }
          ]
        },
        {
          "bar": 3,
          "image": "res://assets/illustrated/campaign/stills/book-ch7-motorcade.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 3.25,
              "text": "The President was driving up the coast to sign a peace accord. Under the bay, a bed was already made up for her.",
              "narration": "",
              "seconds": 7.12
            }
          ]
        },
        {
          "bar": 6,
          "image": "res://assets/illustrated/campaign/stills/book-ch7-show.webp",
          "from": [
            0.58,
            0.5,
            1.0
          ],
          "to": [
            0.44,
            0.52,
            1.1
          ],
          "lines": [
            {
              "bar": 6.25,
              "text": "Nobody would believe us if we told them. So we decided to show them.",
              "narration": "",
              "seconds": 4.96
            }
          ]
        }
      ]
    },
    "ch8": {
      "title": "No engine",
      "before": "p_meeting",
      "music": {
        "file": "res://assets/audio/music/chapter-08-theme.mp3",
        "bar": 0
      },
      "end_bar": 8,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch8-silence.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "There is no engine. For a long moment, nobody in that locked room said anything at all.",
              "narration": "",
              "seconds": 6.64
            },
            {
              "bar": 2.543,
              "text": "Two countries had faked a miracle, and a fleet had crossed the dark to steal it.",
              "narration": "",
              "seconds": 5.6
            }
          ]
        },
        {
          "bar": 5,
          "image": "res://assets/illustrated/campaign/stills/book-ch8-notebook.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 5.25,
              "text": "Then Dr. Wen opened Mom’s notebook and began to read.",
              "narration": "",
              "seconds": 4.0
            }
          ]
        }
      ]
    },
    "ch9": {
      "title": "Back under the bay",
      "before": "c9_gallery",
      "music": {
        "file": "res://assets/audio/music/chapter-09-theme.mp3",
        "bar": 1
      },
      "end_bar": 12,
      "panels": [
        {
          "bar": 1.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch9-aquarium.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 1.25,
              "text": "We went in through Nora’s aquarium, past the sleeping otters and the dark tanks, the way I had gone in alone.",
              "narration": "",
              "seconds": 6.72
            }
          ]
        },
        {
          "bar": 4,
          "image": "res://assets/illustrated/campaign/stills/book-ch9-tunnel.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 4.25,
              "text": "Stephen carried the rig. June carried the plan. Pell carried Biscuit, who refused to get her paws wet.",
              "narration": "",
              "seconds": 7.36
            }
          ]
        },
        {
          "bar": 7,
          "image": "res://assets/illustrated/campaign/stills/book-ch9-glow.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 7.25,
              "text": "At the end of the tunnel the amber light was waiting. Somewhere inside it, if Iris was right, Nora was awake.",
              "narration": "",
              "seconds": 7.84
            }
          ]
        }
      ]
    },
    "ch10": {
      "title": "One hour",
      "before": "c10_station",
      "music": {
        "file": "res://assets/audio/music/chapter-10-theme.mp3",
        "bar": 1
      },
      "end_bar": 11,
      "panels": [
        {
          "bar": 1.0,
          "image": "res://assets/illustrated/campaign/stills/book-ch10-vigil.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 1.25,
              "text": "The Vigil hung over the bay like a second moon. Nobody in Bellwether went back to bed.",
              "narration": "",
              "seconds": 6.08
            }
          ]
        },
        {
          "bar": 4,
          "image": "res://assets/illustrated/campaign/stills/book-ch10-pier.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 4.25,
              "text": "Three hundred people stood on the pier in wet pajamas, looking up at the thing that had come to check on them.",
              "narration": "",
              "seconds": 6.8
            }
          ]
        },
        {
          "bar": 7,
          "image": "res://assets/illustrated/campaign/stills/book-ch10-hand.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 7.25,
              "text": "Stephen kept checking the name he had written on his hand. Frank. Dad. Every few seconds.",
              "narration": "",
              "seconds": 6.8
            }
          ]
        }
      ]
    },
    "home": {
      "title": "Home",
      "before": "epilogue",
      "music": {
        "file": "res://assets/audio/music/epilogue-bgm.mp3",
        "bar": 0
      },
      "end_bar": 9,
      "panels": [
        {
          "bar": 0.0,
          "image": "res://assets/illustrated/campaign/stills/book-home-rise.webp",
          "from": [
            0.5,
            0.6,
            1.1
          ],
          "to": [
            0.5,
            0.42,
            1.02
          ],
          "lines": [
            {
              "bar": 0.25,
              "text": "For a while it just hung there over the water, as if it wanted one more look at us. Then it was gone.",
              "narration": "",
              "seconds": 7.6
            }
          ]
        },
        {
          "bar": 3,
          "image": "res://assets/illustrated/campaign/stills/book-home-towels.webp",
          "from": [
            0.42,
            0.52,
            1.08
          ],
          "to": [
            0.56,
            0.5,
            1.0
          ],
          "lines": [
            {
              "bar": 3.25,
              "text": "Three hundred and twelve people came home that morning. Most of them were still in pajamas.",
              "narration": "",
              "seconds": 5.76
            }
          ]
        },
        {
          "bar": 6,
          "image": "res://assets/illustrated/campaign/stills/book-home-tables.webp",
          "from": [
            0.5,
            0.55,
            1.0
          ],
          "to": [
            0.5,
            0.5,
            1.1
          ],
          "lines": [
            {
              "bar": 6.25,
              "text": "And down on the pier, Carmen started setting up tables.",
              "narration": "",
              "seconds": 3.76
            }
          ]
        }
      ]
    }
  }
}
