extends SceneTree
## Verify each supplied recording through the campaign scene and its ordinary transitions.
var game: Node
var catalog: Dictionary
var checks := 0
var errors: Array[String] = []
var recordings := {}
var report_dir := OS.get_environment("NIGHT_NINE_QA_DIR")

func _initialize() -> void:
	run.call_deferred()

func check(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		errors.append(label)
		push_error(label)

func frames(count: int) -> void:
	for i in count:
		await process_frame

func verify_credit_pages() -> void:
	var reel: Control = game.credit_reel
	var pages: Array = []
	for start: float in reel.CARD_START:
		reel.elapsed = start + .83
		reel.present()
		await frames(3)
		var text: Array[String] = []
		for label: Label in reel.names.find_children("*", "Label", true, false):
			text.append(label.text)
			check(label.size.y >= label.get_line_count() * label.get_line_height(), "Keep credit text fully visible: " + label.text)
			check(label.get_global_rect().end.y <= game.credits_return.get_global_rect().position.y - 20, "Keep credit text clear of navigation: " + label.text)
		pages.append(text)
		if DisplayServer.get_name() != "headless":
			RenderingServer.force_draw(false)
			check(root.get_texture().get_image().save_png(report_dir.path_join("credits-%02d.png" % pages.size())) == OK, "Capture credit page")
	for group: Array in [
		["Google Lyria 3.5", "Claude Opus 5.5", "GPT Astra 6.2", "GPT Image 2.6", "ElevenLabs 4"],
		["GitHub", "GitHub Copilot Fusion", "Cloudflare Pages"],
		["Built using", "Godot Engine for Browsers"],
	]:
		check(pages.any(func(page: Array): return group.all(func(name: String): return name in page)), "Show these credits together: " + ", ".join(group))
	reel.start(false, false)

func player() -> AudioStreamPlayer:
	return game.score.players[game.score.active_index]

func verify_track(kind: String, record: Dictionary) -> void:
	var path: String = record.file
	check(game.score.cue == kind and game.score.current_file == path, "Select " + path)
	var deck := player()
	check(deck.playing and deck.stream is AudioStreamMP3, "Play the supplied MP3 " + path)
	if deck.stream != null:
		check(absf(deck.stream.get_length()-load(path).get_length()) < .01, "Keep the master duration of " + path)
	recordings[path] = true

func finish_lines() -> void:
	for i in 28:
		if not game.dialogue_panel.visible:
			return
		game._next_line()
	check(false,"Return to exploration or the departure film after the lines")

## Storybooks and chapter cards are checked in story_flow_qa.gd; here they are passed quickly.
func clear_overlays() -> void:
	for i: int in 4:
		if game.storybook.visible:
			game.storybook.finish_now()
		if game.title_card.visible:
			game.title_card.finish_now()
		await frames(1)

func planned(scene: Dictionary) -> Dictionary:
	return catalog.get("scene_music",{}).get(scene.id,{})

func has_book(scene_id: String) -> bool:
	var books: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://content/storybook.json")).books
	for book: Dictionary in books.values():
		if book.before == scene_id:
			return true
	return false

func solve(task: Dictionary) -> void:
	if not task.actor.is_empty():
		game.campaign.switch_actor(task.actor)
	var answer: Dictionary = game.campaign.choose(task.id,task.answer,task.get("puzzle",{}).get("solution",[]))
	check(answer.ok, "Prepare " + str(task.id))
	game.campaign.mark_seen(task.lines)

func run() -> void:
	if report_dir.is_empty() or OS.get_environment("NIGHT_NINE_SAVE_DIR").is_empty():
		push_error("Set empty QA and save directories for the score test")
		quit(2)
		return
	DirAccess.make_dir_recursive_absolute(report_dir)
	Engine.max_fps = 120
	catalog = JSON.parse_string(FileAccess.get_file_as_string("res://content/music.json"))
	game = load("res://scenes/campaign.tscn").instantiate()
	root.add_child(game)
	await frames(4)
	verify_track("title",catalog.title)
	var title_deck := player()
	game._open_credits()
	await frames(2)
	check(not game.credit_reel.landscape.texture.resource_path.contains("/rewards/"), "Keep completion artwork out of pre-game credits")
	check(game.credits_body.text.contains("S3PehR") and player() == title_deck and not title_deck.stream_paused, "Keep the title playing under the soundtrack credit")
	check(game.credits_body.text.contains("[b]Music generated by[/b]\nGoogle Lyria 3.5\n\n"), "Credit the music generation model along with the composer")
	await verify_credit_pages()
	game._close_credits()
	var old_volume: float=game.music_volume.value
	game.music_volume.value=0.0
	await frames(2)
	check(is_zero_approx(game.score.volume) and is_zero_approx(game.settings.get_value("audio","music",-1.0)), "Persist the independent music mute")
	game.music_volume.value=old_volume
	game._new_game()
	await frames(1)
	check(game.storybook.visible and game.score.current_file.ends_with("prologue-theme.mp3"), "Open the backstory on the Three Nights theme")
	recordings[game.score.current_file] = true
	await clear_overlays()
	for scene: Dictionary in game.campaign.content.scenes:
		check(scene.id == game.campaign.current().id,"Enter " + str(scene.id))
		if scene.id == "postcredits":
			await create_timer(1.5).timeout
			check(game.score.cue=="silence","Leave the final radio signal clear")
			break
		var group: Dictionary = catalog.chapters[scene.chapter]
		var heard: Dictionary = planned(scene)
		await clear_overlays()
		await frames(2)
		verify_track("bgm" if heard.role == "bgm" else "scene",heard)
		check(heard.file != catalog.credits.file, "Keep the ending reward music out of " + str(scene.id))
		if scene.id == "p_bay":
			await create_timer(.35).timeout
			check(not game.voice.playing and game.score.duck_db > -3.0, "Keep text-only dialogue silent without falsely ducking the score")
		finish_lines()
		var deck := player()
		if scene.id == "c1_dinner":
			# The score rides a quiet passage up and is back down before a loud one.
			var loud: Array = heard.bar_loudness
			var bar: float = game.score.bar_length(heard)
			var quiet := -1
			var peak := 0
			for i in loud.size() - 1:
				if quiet < 0 and maxf(loud[i],loud[i+1]) < float(heard.lufs) - 9.0:
					quiet = i
				if minf(loud[i],loud[i+1]) > minf(loud[peak],loud[peak+1]):
					peak = i
			check(quiet >= 0, "Find a quiet passage in the Chapter 1 BGM")
			deck.seek(float(heard.beat) + bar * (quiet + .1))
			await create_timer(1.2).timeout
			check(game.score.ride_db > .5 and game.score.ride_db <= game.score.MAX_RIDE_DB, "Ride the Chapter 1 BGM up through a quiet passage")
			deck.seek(float(heard.beat) + bar * (peak + .1))
			await create_timer(.6).timeout
			check(game.score.ride_db < .1, "Bring the ride down before a loud passage")
		if scene.id == "c1_pier":
			deck.seek(29.0)
			game.menu.show()
			game._pause_audio(true)
			await frames(2)
			check(player()==deck and not deck.stream_paused and game.score.duck_target_db < 0, "Keep the pier music at a lower level in the pause menu")
			game._continue()
			await frames(3)
			check(not deck.stream_paused and deck.get_playback_position()>27.0, "Resume the same musical phrase")
		for task: Dictionary in scene.tasks:
			if task.id == "c1_flat.compare":
				game._inspect_on_arrival(task.id)
				await create_timer(.5).timeout
				check(game.tape_compare.visible and game.score.duck_db < -22.0, "Clear the soundtrack under the tape-alignment puzzle")
				game.tape_compare.close()
			solve(task)
		game._refresh()
		var next_scene: Dictionary = game.campaign.content.scenes[int(game.campaign.data.scene)+1]
		var boundary: bool = next_scene.chapter != scene.chapter
		var cue: Dictionary = catalog.get("departures",{}).get(scene.id,{})
		var same_music: bool = not boundary and cue.is_empty() and planned(next_scene).get("file","") == heard.file and not has_book(next_scene.id)
		if same_music:
			deck.seek(23.0)
		game._depart()
		finish_lines()
		await frames(2)
		if not cue.is_empty():
			check(game.score.cue == "theme" and game.score.current_file == cue.file, "Departure music for " + str(scene.id))
			var bar: float = game.score.bar_length(cue)
			check(absf(game.cut_duration - float(cue.bars) * bar) < .01, "Departure lasts whole bars in " + str(scene.id))
			recordings[cue.file] = true
		elif boundary:
			verify_track("theme",group.theme)
			var bar: float = game.score.bar_length(group.theme)
			check(absf(fposmod(game.cut_duration + bar * .5, bar) - bar * .5) < .01, "Chapter film lasts whole bars in " + str(scene.id))
		elif same_music:
			check(player()==deck and game.score.current_file==heard.file,"Keep the chapter music through " + str(scene.id))
		game._advance_scene()
		if scene.id == "one_year":
			check(game.credits_panel.visible and game.score.current_file==catalog.credits.file and not player().stream_paused,"Play the exclusive reward cue with the completion film")
			check(game.credit_reel.landscape.texture.resource_path.contains("/rewards/"), "Reveal exclusive artwork only in the completion film")
			recordings[catalog.credits.file] = true
			game._close_credits()
		elif same_music:
			await frames(2)
			check(player()==deck and deck.get_playback_position()>21.0,"Continue the same BGM position in "+str(next_scene.id))
	# The end card plays the short Epilogue theme once.
	game.campaign.data.finished = true
	game._load_stage(false)
	await frames(2)
	verify_track("theme",catalog.finale)
	check(not player().stream.loop, "Play the Epilogue theme once under the end card")
	var mp3s := 0
	for name: String in DirAccess.get_files_at("res://assets/audio/music"):
		if name.ends_with(".mp3"):
			mp3s += 1
	check(recordings.size()==mp3s and mp3s==30, "Hear all 30 supplied recordings")
	var file := FileAccess.open(report_dir.path_join("score-route.json"),FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"failures":errors,"stream_count":recordings.size(),"recordings":recordings.keys(),"audio_driver":AudioServer.get_driver_name()},"  ")+"\n")
	file.close()
	print("Soundtrack route: ",checks," checks, ",errors.size()," failures, ",recordings.size()," recordings")
	await game.drain_audio()
	quit(0 if errors.is_empty() else 1)
