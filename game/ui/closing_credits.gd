extends Control
## The same contributor list is available immediately in the plain text view.
signal finished

const ROLES := [
	["Game script, story, direction and original music","Sepehr (S3pehR) Pakbaz"],
	["Music generated by","Google Lyria 3.5"],
	["Game scripts generated by","Claude Opus 5.5"],
	["Game engine, animation, 3D work and gameplay","GPT 6.2 Astra"],
	["Artwork and pictures, including characters","GPT Image 2.6"],
	["Voices","ElevenLabs 4"],
]
const CARD_START := [0.0,6.7,12.9,18.9,26.2,32.4]
const END := 39.8
const OPENING_ART := ["rooms/bay.png","campaign/rooms/c5_station.webp","campaign/rooms/c3_archive.webp","rooms/veyr.png","campaign/rooms/c1_pier.webp","rooms/meeting.png"]
const ENDING_ART := ["campaign/inserts/epilogue.webp","campaign/rooms/c5_station.webp","campaign/rooms/c3_archive.webp","campaign/inserts/c10_report-motion.webp","campaign/rooms/i2_nora.webp","campaign/inserts/one_year.webp"]

var elapsed := 0.0
var card := -1
var at_ending := false
var landscape: TextureRect
var wash: TextureRect
var names: VBoxContainer
var role: Label
var person: Label
var running := false
var motion := true

func _ready() -> void:
	mouse_filter=Control.MOUSE_FILTER_IGNORE
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	clip_contents=true
	landscape=TextureRect.new()
	landscape.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
	landscape.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_COVERED
	landscape.mouse_filter=Control.MOUSE_FILTER_IGNORE
	add_child(landscape)
	landscape.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var gradient := Gradient.new()
	gradient.colors=PackedColorArray([Color(.012,.025,.030,.92),Color(.012,.025,.030,.79),Color(.028,.035,.038,.22)])
	gradient.offsets=PackedFloat32Array([0,.45,1])
	var strip := GradientTexture2D.new()
	strip.gradient=gradient
	strip.width=256
	strip.height=2
	strip.fill_to=Vector2(1,0)
	wash=TextureRect.new()
	wash.texture=strip
	wash.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
	wash.mouse_filter=Control.MOUSE_FILTER_IGNORE
	add_child(wash)
	wash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	names=VBoxContainer.new()
	names.mouse_filter=Control.MOUSE_FILTER_IGNORE
	names.add_theme_constant_override("separation",12)
	add_child(names)
	names.set_anchors_preset(Control.PRESET_TOP_LEFT)
	role=Label.new()
	role.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
	role.add_theme_color_override("font_color",Color("e4cfaa"))
	role.add_theme_font_size_override("font_size",25)
	names.add_child(role)
	person=Label.new()
	person.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
	person.add_theme_font_size_override("font_size",56)
	person.add_theme_color_override("font_color",Color("fff4df"))
	var serif := SystemFont.new()
	serif.font_names=PackedStringArray(["Georgia","Noto Serif","Liberation Serif"])
	person.add_theme_font_override("font",serif)
	names.add_child(person)

func start(ending: bool, panning: bool) -> void:
	at_ending=ending
	motion=panning
	elapsed=0
	card=-1
	running=true
	present()

func present() -> void:
	var index:=0
	for i in range(1,CARD_START.size()):
		if elapsed>=CARD_START[i]:
			index=i
	if index!=card:
		card=index
		var path: String = "res://assets/illustrated/" + (ENDING_ART[index] if at_ending else OPENING_ART[index])
		if not ResourceLoader.exists(path):
			path="res://assets/illustrated/rooms/bay.png"
		landscape.texture=load(path)
		role.text=ROLES[index][0]
		person.text=ROLES[index][1]
	var span:float=(CARD_START[index+1] if index+1<CARD_START.size() else END)-CARD_START[index]
	var local:float=elapsed-CARD_START[index]
	var alpha:=smoothstep(0,.55,local)*(1.0-smoothstep(span-.45,span,local))
	names.modulate.a=alpha
	landscape.modulate=Color.WHITE * (.40 + .60 * smoothstep(0,.78,local)*(1.0-smoothstep(span-.50,span,local)))
	landscape.modulate.a=1
	names.size.x=size.x*.60
	names.position=Vector2(size.x*.095,size.y*.47-4*smoothstep(0,.70,local))
	var drift:=smoothstep(0,span,local) if motion else 0.0
	landscape.pivot_offset=size*Vector2(.71,.47)
	landscape.scale=Vector2.ONE*(1.015+.035*drift)

func _process(delta: float) -> void:
	if not running or not is_visible_in_tree():
		return
	elapsed=minf(END,elapsed+delta)
	present()
	if elapsed>=END:
		running=false
		finished.emit()
