      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch7.2.1.wav",
        "seconds": 7.12,
        "caption": "The President was driving up the coast to sign a peace accord. Under the bay, a bed was already made up for her.",
        "status": "automated_qa_passed",
