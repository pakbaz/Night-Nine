      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-script-v2/book.after.6.2.wav",
        "seconds": 2.88,
        "caption": "From very, very far away.",
        "status": "automated_qa_passed",
        "text_hash": "08e48f791b5cd083"
      }
    ],
    "ch2": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch2.1.1.wav",
        "seconds": 7.76,
        "caption": "Nobody swam. Nobody called for help. They walked into the bay in their good shoes, and the water closed over them.",
        "status": "automated_qa_passed",
        "text_hash": "eb0979ec0ba1fcfc"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch2.1.2.wav",
        "seconds": 5.68,
        "caption": "Lyle Boone. Gus from the bakery. People I’d waved at my whole life.",
        "status": "automated_qa_passed",
        "text_hash": "38cb741526d5e927"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch2.2.1.wav",
        "seconds": 6.72,
        "caption": "Then the light went out of the water. Mrs. Penhallow’s step was empty. Only the footprints were left.",
