    "ch7": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch7.1.1.wav",
        "seconds": 5.92,
        "caption": "On Wednesday morning, every television in Bellwether showed the same field of old antennas.",
