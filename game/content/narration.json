    "interlude1": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.interlude1.1.1.wav",
        "seconds": 3.2,
        "caption": "I didn’t learn the rest of that night until much later.",
        "status": "automated_qa_passed",
        "text_hash": "51389657dc097a74"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.interlude1.1.2.wav",
        "seconds": 7.92,
        "caption": "While June and I watched from the boathouse, two hundred and seventy-four people walked along the floor of the bay, toward a light.",
        "status": "automated_qa_passed",
        "text_hash": "83af9ab378300f12"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.interlude1.2.1.wav",
        "seconds": 5.12,
        "caption": "Under the bay, in a hall of glass records, someone was waiting for them.",
        "status": "automated_qa_passed",
        "text_hash": "53712a9656982921"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.interlude1.2.2.wav",
        "seconds": 3.6,
        "caption": "She had been keeping records for nine hundred years.",
        "status": "automated_qa_passed",
        "text_hash": "4ebbfa3b4c1e3cf5"
      }
    ],
    "ch4": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch4.1.1.wav",
        "seconds": 7.12,
        "caption": "For two days June called in favors from people she trusted, and I copied every tape I owned. Twice.",
        "status": "automated_qa_passed",
        "text_hash": "6b4e061e650b0989"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch4.2.1.wav",
        "seconds": 7.12,
        "caption": "She trusted Adrian Rook with her life. Twenty years ago, he had helped her bring a kidnapped child home.",
        "status": "automated_qa_passed",
        "text_hash": "b8930a625e8970bf"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch4.3.1.wav",
        "seconds": 5.28,
        "caption": "Help is coming, she said. I wanted to believe that more than anything.",
        "status": "automated_qa_passed",
        "text_hash": "fa199a55aca3b0e8"
      }
    ],
    "ch5": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch5.1.1.wav",
        "seconds": 6.32,
        "caption": "The creek was colder than the bay. I followed it down through the dark, one stone at a time.",
        "status": "automated_qa_passed",
        "text_hash": "e230e5fbd3c0506b"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch5.2.1.wav",
        "seconds": 8.8,
        "caption": "Twice a searchlight crossed the trees above me. Twice I held my breath and counted, the way Dad taught me to count after lightning.",
        "status": "automated_qa_passed",
        "text_hash": "2f79e9558da883cf"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch5.3.1.wav",
        "seconds": 5.52,
        "caption": "At first light I could see the bay again. And on the bluff above it, a roof I knew.",
        "status": "automated_qa_passed",
        "text_hash": "064e775d84d11944"
      }
    ],
    "ch6": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch6.1.1.wav",
        "seconds": 6.96,
        "caption": "I walked home that night with a man who had my face, my voice, and a year and a half of my life missing.",
        "status": "automated_qa_passed",
        "text_hash": "d4a57d014df4e2cd"
      },
      {
