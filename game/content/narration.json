        "text_hash": "25330f1acdff427b"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch6.3.1.wav",
        "seconds": 7.84,
        "caption": "But he knew how I take my coffee, and which stair creaks at Mom’s house. It was like meeting a brother I already was.",
        "status": "automated_qa_passed",
        "text_hash": "352a1df5d4f60ff0"
      }
    ],
