        "status": "automated_qa_passed",
        "text_hash": "89b4faac1fb418f5"
      }
    ],
    "ch3": [
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch3.1.1.wav",
        "seconds": 6.96,
        "caption": "I had seen her. Nora, asleep in amber light, breathing a little behind the ship’s own rhythm.",
        "status": "automated_qa_passed",
        "text_hash": "6d604795d63115f6"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch3.2.1.wav",
        "seconds": 6.4,
        "caption": "Admiral left me in the shallows at first light, then swam back out into the dark water without me.",
        "status": "automated_qa_passed",
        "text_hash": "bfa991dfc042b473"
      },
      {
        "file": "res://assets/audio/voices/elevenlabs-v4-additions/book.ch3.3.1.wav",
        "seconds": 6.32,
        "caption": "Getting off the ship was the easy part. The hard part was finding one person who would believe me.",
        "status": "automated_qa_passed",
